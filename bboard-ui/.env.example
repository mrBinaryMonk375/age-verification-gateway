# Age Verification Gateway — Environment Configuration
# Copy this file to .env and fill in the values

# Network: undeployed | standalone | preview | preprod
VITE_NETWORK=undeployed

# Contract address (from `npm run cli` deploy output)
VITE_CONTRACT_ADDRESS=

# Proof server URL (default: local proof server via Docker)
VITE_PROOF_SERVER_URL=http://localhost:6300

# Indexer endpoints (leave empty for undeployed/standalone mode)
VITE_INDEXER_URL=
VITE_INDEXER_WS_URL=

# Node RPC endpoint
VITE_NODE_URL=
